/*Q97: Print the initials of a name.

/*
Sample Test Cases:
Input 1:
John Doe
Output 1:
J.D.

*/
#include <stdio.h>
#include <string.h>

int main()
{
    char name[50];
    int i;

    printf("Enter full name: ");
    gets(name);

    printf("%c.", name[0]);

    for (i = 1; i < strlen(name); i++)
    {
        if (name[i - 1] == ' ' && name[i] != ' ')
            printf("%c.", name[i]);
    }

    return 0;
}